{
  "name": "bwg-usage",
  "version": "0.1.0",
  "description": "A self-hosted BandwagonHost VPS resource, traffic, and operations dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axin7/bwg-usage.git"
  },
  "homepage": "https://bwg-usage.vercel.app/",
  "bugs": {
    "url": "https://github.com/axin7/bwg-usage/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@heroui/shared-utils"
    ],
    "overrides": {
      "fflate@<0.7.5": "0.7.5"
    }
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:vercel": "vite build --mode vercel",
    "verify:vercel": "node scripts/verify-vercel.mjs",
    "check:compat": "vinext check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "framer-motion": "14.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
