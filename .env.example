# Browser-managed credentials work without environment variables.
# Uncomment and set these three together to enable optional panel password login.
# APP_ORIGIN=
# PANEL_PASSWORD=
# SESSION_SECRET=
# Redis is optional; omit both to use per-instance in-memory limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Server-managed VPS credentials require panel password login.
# BWG_VEID=
# BWG_API_KEY=
